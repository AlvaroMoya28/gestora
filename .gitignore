# --- Secretos: nunca se versionan --------------------------------------------
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json
.env
.env.local
.env.*.local
*.pfx
*.key

# --- .NET --------------------------------------------------------------------
bin/
obj/
*.user
*.suo
.vs/
TestResults/

# --- Node --------------------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- Base de datos -----------------------------------------------------------
# database/schema/gestora_datos.sql sí se versiona: son datos de demostración
# inventados, para levantar la misma base en otra máquina. Los respaldos de una
# empresa real van en database/backups/ y nunca se suben: llevan los correos y
# el hash de contraseña de sus usuarios y toda su información comercial.
database/backups/*.sql
!database/backups/.gitkeep

# --- Editores y sistema ------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db
.DS_Store
