# Credenciales reales de la base de datos. Nunca se versionan.
includes/config.php

# Log del respaldo automático
backups/cron.log

# Sistema
.DS_Store
Thumbs.db

# Respaldos de la base.
#
# CAMBIO 2026-08-21: antes se versionaban a propósito, para que el historial de
# git sirviera también de respaldo. Eso tenía sentido cuando al repositorio solo
# accedían las personas del programa.
#
# Al dar acceso a personas colaboradoras externas (ver ACCESOS_ASISTENTE.md), un
# dump deja de ser un respaldo y pasa a ser una copia de los datos personales de
# 19 funcionarios y de 1.008 centros educativos —nombres, correos y teléfonos de
# directores— en manos de cualquiera con acceso de lectura al repositorio. Y una
# vez subido, queda en el historial aunque después se borre el archivo.
#
# Los respaldos viven en el servidor, que es donde el sistema los crea y los
# lee. Si hace falta guardarlos fuera, va a un lugar aparte, no al repositorio.
backups/*.sql
