# Raíz del sitio. A diferencia de includes/, schema/, scripts/ y backups/,
# esta carpeta SÍ se sirve: acá viven index.php y las páginas de módulo.
#
# Lo que se bloquea son los archivos de documentación y datos que quedaron
# junto al código. CONTEXTO.md describe las rutas del servidor, el host de la
# base y qué carpetas guardan datos personales — es justo el mapa que le
# serviría a alguien buscando por dónde entrar.
<FilesMatch "\.(md|sql|gitignore|example\.php)$">
    # Apache 2.4
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    # Apache 2.2
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Archivos ocultos (.git, .env y compañía), por si alguno llega a colarse.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Sin index en una carpeta, no listar su contenido: el listado revelaría los
# nombres de las carpetas privadas aunque su contenido esté bloqueado.
Options -Indexes

# ------------------------------------------------------------------
# HTTPS obligatorio
#
# Ahora que el sitio vive en https://gestionpaa.ucr.ac.cr/ ya no hace falta
# tolerar HTTP: todo lo que llegue por el puerto 80 se manda por 301 al mismo
# camino en https. Se revisa X-Forwarded-Proto además de HTTPS por si el
# tráfico entra a través de un balanceador de UCR que termina el TLS antes de
# llegar acá — sin eso, un servidor detrás de un proxy así entraría en un
# bucle de redirección porque nunca ve la conexión como segura.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------
# Cabeceras de seguridad
#
# X-Frame-Options/frame-ancestors: nadie más puede meter el sitio en un
#   <iframe> propio (clickjacking).
# X-Content-Type-Options: el navegador no reinterpreta un archivo como otro
#   tipo de contenido distinto al que el servidor dijo que era.
# Referrer-Policy: no manda la URL completa (que puede llevar folios, ids)
#   como referrer hacia sitios de fuera.
# Permissions-Policy: apaga cámara/micrófono/ubicación, que este sitio no usa.
# Strict-Transport-Security: una vez que el navegador entró por https, que no
#   vuelva a intentar por http ni aunque alguien le dé un enlace viejo.
# Content-Security-Policy: solo carga scripts, hojas de estilo y fuentes de
#   los dominios que el sitio realmente usa (Google Fonts, Font Awesome vía
#   cdnjs, jsPDF/html2canvas/xlsx vía jsdelivr y unpkg, imágenes de respaldo
#   de Unsplash en Sedes). 'unsafe-inline' sigue permitido en script/style
#   porque el sitio no usa nonces y cada módulo trae su JS y su CSS dentro
#   del mismo archivo — no es la protección contra XSS (ver includes/db.php
#   y el escape con h()/escapar()), es la barrera contra que un script o una
#   imagen carguen desde un dominio que no es ninguno de los de arriba.
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
